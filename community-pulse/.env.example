# Copy this file to .env.local and fill in the values

# Deployed CommunityPulse v2 contract address on studionet
NEXT_PUBLIC_CONTRACT_ADDRESS=0xA55653c4167477B062515Fc5B10F587Ac5d9cF2a

# GenLayer studionet RPC (default — only change if using a different network)
NEXT_PUBLIC_GENLAYER_RPC=https://studio.genlayer.com/api

# GenLayer studionet chain ID (61999 decimal)
NEXT_PUBLIC_CHAIN_ID=61999
